# Template for `.env` (git-ignored): `cp .env.example .env`, then adjust.
# One file for the whole repository: the server, its integration tests, the web app and docker compose read it.
# A variable that is already set in the real environment (CI, containers) wins over this file.

# --- Postgres (docker compose creates the database with these) ---
POSTGRES_USER=fieldsync
POSTGRES_PASSWORD=fieldsync
POSTGRES_DB=fieldsync

# --- Server ---
# HTTP port
PORT=3001
# Postgres connection string (required). As seen from the host; inside docker compose the server is given the
# `postgres` service address instead.
DATABASE_URL=postgres://fieldsync:fieldsync@localhost:5432/fieldsync
# Connection pool size
DB_POOL_MAX=20
# Insert demo users and sites at boot (true/false)
SEED_DEMO=true
# Comma-separated CORS allow-list
CORS_ORIGINS=http://localhost:3000
# How long change-log rows are kept, seconds
CHANGELOG_RETENTION_SECONDS=604800
# How long idle clients rows are kept, days
CLIENT_RETENTION_DAYS=90
# Change-log GC period, milliseconds
GC_INTERVAL_MS=3600000
# SSE heartbeat period, milliseconds
STREAM_HEARTBEAT_MS=25000
# Maximum concurrent SSE streams per user
STREAM_MAX_PER_USER=10
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# If set, /metrics requires it as a bearer token
METRICS_TOKEN=

# --- Web ---
# API base URL used by the browser; inlined when the web app is built
NEXT_PUBLIC_API_URL=http://localhost:3001
