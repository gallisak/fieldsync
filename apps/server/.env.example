# HTTP port
PORT=3001
# Postgres connection string (required)
DATABASE_URL=postgres://fieldsync:fieldsync@postgres:5432/fieldsync
# Connection pool size
DB_POOL_MAX=20
# Insert demo users and sites at boot (true/false)
SEED_DEMO=true
# Comma-separated CORS allow-list
CORS_ORIGINS=http://localhost:3000
# How long change-log rows are kept, seconds
CHANGELOG_RETENTION_SECONDS=604800
# How long idle clients rows are kept, days
CLIENT_RETENTION_DAYS=90
# Change-log GC period, milliseconds
GC_INTERVAL_MS=3600000
# SSE heartbeat period, milliseconds
STREAM_HEARTBEAT_MS=25000
# Maximum concurrent SSE streams per user
STREAM_MAX_PER_USER=10
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# If set, /metrics requires it as a bearer token
METRICS_TOKEN=
