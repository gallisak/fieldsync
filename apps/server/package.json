{
  "name": "@fieldsync/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/database/migrations && cp src/database/migrations/*.sql dist/database/migrations/",
    "start": "node dist/main",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "test:unit": "jest --passWithNoTests --testPathIgnorePatterns integration sim",
    "test:integration": "jest integration",
    "test:sim": "jest sim --passWithNoTests"
  },
  "dependencies": {
    "@fieldsync/sync-core": "*",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.11.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "setupFiles": [
      "<rootDir>/test/support/env.ts"
    ]
  }
}
